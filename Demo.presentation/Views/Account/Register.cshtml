@using Demo.presentation.VIEW_Model;
@model RegisterViewModel;


@{
	
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthenLayout1.cshtml";
}

<h1>Register</h1>

<div class="main-w3layouts wrapper">
	<h1>Creative SignUp Form</h1>
	<div class="main-agileinfo">
		<div class="agileits-top">
			<form asp-action="Register" method="post">
				<div   asp-validation-summary="ModelOnly"></div>
				<input asp-for="UserName"  placeholder="UserName" />
				<span asp-validation-for="UserName"  class="text-danger"></span>


				<input asp-for="FirstName" placeholder="FirstName" />
				<span asp-validation-for="FirstName" class=" text-danger"></span>


				<input asp-for="LastName" placeholder="LastName" />
				<span asp-validation-for="LastName" class=" text-danger"></span>

				

				<input asp-for="Email" placeholder="Email" />
				<span asp-validation-for="Email" class=" text-danger"></span>



				<input asp-for="Password" placeholder="Password" />
				<span asp-validation-for="Password" class=" text-danger"></span>

				<input asp-for="ConfirmPassword" placeholder="ConfirmPassword" />
				<span asp-validation-for="ConfirmPassword" class=" text-danger"></span>



				<div class="wthree-text">
					<label class="anim">
						<input asp-for="IsAgreed" placeholder="IsAgreed" />
						<span asp-validation-for="IsAgreed" class=" text-danger"></span>


					</label>
					<div class="clear"> </div>
				</div>
				<input type="submit" value="SIGNUP">
			</form>
			<p>Do you  have an Account? <a asp-action="Login"> Login Now!</a></p>
		</div>
	</div>	

	<footer>

		@section  validation{
			<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>


			<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

		}
	</footer>

