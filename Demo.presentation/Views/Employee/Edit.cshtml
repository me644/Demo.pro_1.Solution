

@using Demo.DAL.Emp_Module
@using Demo.DAL.Shared
@using Demo.PLL.EDTO_S;


@using Demo.presentation.VIEW_Model

@model EmployeeViewModel







<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Edit Employee</h1>
    <form method="post" asp-controller="Employee" asp-action="Edit" asp-route-id="@Model.id" class=" row col-8" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly"></div>
        <partial name="Partial_view/_Parital_CE_VIEW" model="Model"></partial>

        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Save" />
            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>
    </form>
</div>
