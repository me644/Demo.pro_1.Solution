@using Demo.presentation.VIEW_Model
@model RoleViewModel

<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Edit Role</h1>

    <form method="post" asp-controller="Role" asp-action="Edit" asp-route-id="@Model.Id" class="col-8">
        <div asp-validation-summary="ModelOnly"></div>

        <!-- Role Name -->
        <div class="form-group mb-3">

            <input type="hidden" asp-for="Id" />

            <label class="form-label" asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- Users assigned to this role -->
        <h3>Assign Users to Role</h3>
        <div class="form-group">
            @for (int i = 0; i < Model.Users.Count; i++)
            {
                <input type="hidden" asp-for="@Model.Users[i].Id" />
                <input type="hidden" asp-for="@Model.Users[i].UserName" />

                <div class="form-check">
                    <input asp-for="@Model.Users[i].IsSelected" class="form-check-input" />
                    <label class="form-check-label">@Model.Users[i].UserName</label>
                </div>
            }
        </div>

        <!-- Buttons -->
        <div class="mt-4 m-auto">
            <input class="btn btn-primary" type="submit" value="Save Changes" />
            <a asp-controller="Role" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
        </div>
    </form>
</div>
